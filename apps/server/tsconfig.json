{
  "extends": "../../tsconfig.json",

  "compilerOptions": {
    "module": "commonjs",
    "declaration": true,
    "removeComments": true,
    "esModuleInterop": true, // Přidá podporu pro defaultní importy ESM modulů
    "allowSyntheticDefaultImports": true,
    "target": "ES2021",
    "sourceMap": true,
    "outDir": "./dist"
  }
}
